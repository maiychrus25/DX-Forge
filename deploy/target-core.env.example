# Copy this file to deploy/.env.core and replace every CHANGE_ME value before running
# `docker compose --env-file deploy/.env.core -f deploy/target-core.yml up`.
# Nothing in this example file is a real credential — see packages/providers/oss/contract/README.md
# for how these values map onto DXFORGE_OSS_CREDENTIALS (the JSON the CLI reads).

# Shared PostgreSQL instance (backs Nextcloud only; Keycloak runs in dev mode with its own
# embedded database — see the comment at the top of target-core.yml).
PG_PASSWORD=CHANGE_ME_postgres_password

# Keycloak bootstrap admin (realm "master"). Also DXFORGE_OSS_CREDENTIALS.keycloak.{admin,password}.
KC_ADMIN=admin
KC_PASSWORD=CHANGE_ME_keycloak_admin_password

# Nextcloud admin account. Also DXFORGE_OSS_CREDENTIALS.nextcloud.{user,password}.
NC_ADMIN=admin
NC_PASSWORD=CHANGE_ME_nextcloud_admin_password

# Non-admin account nextcloud-init.sh creates (username fixed to "staff.test"), used only to probe
# ACLs: a staff member must be refused writing into "3. [R] RESOURCES" and accepted writing into
# their own "2. [A] AREAS/<dept>". Also DXFORGE_OSS_CREDENTIALS.nextcloud.staffPassword.
NC_STAFF_PASSWORD=CHANGE_ME_staff_test_password

# Host ports; change only if 8080/8081 are already taken on this machine.
KC_PORT=8080
NC_PORT=8081
